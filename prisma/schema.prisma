generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model categorias {
  id_usuario   Int?
  usuarios     usuarios?       @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  id_categoria Int             @id @default(autoincrement())
  nome         String          @db.VarChar(50)
  tipo         categorias_tipo
  icone        String?         @db.VarChar(50)
  cor          String?         @db.VarChar(20)
  created_at   DateTime?       @default(now()) @db.Timestamp(0)
  updated_at   DateTime?       @default(now()) @updatedAt @db.Timestamp(0)
  transacoes   transacoes[]

  @@index([id_usuario], map: "idx_categorias_usuario")
}

model metas_financeiras {
  id_meta        Int                       @id @default(autoincrement())
  id_usuario     Int
  titulo         String                    @db.VarChar(100)
  descricao      String?                   @db.VarChar(255)
  valor_objetivo Decimal                   @db.Decimal(10, 2)
  valor_atual    Decimal?                  @default(0.00) @db.Decimal(10, 2)
  status         metas_financeiras_status? @default(em_andamento)
  data_inicio    DateTime?                 @db.Date
  data_fim       DateTime?                 @db.Date
  created_at     DateTime?                 @default(now()) @db.Timestamp(0)
  updated_at     DateTime?                 @default(now()) @updatedAt @db.Timestamp(0)
  usuarios       usuarios                  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, map: "metas_financeiras_ibfk_1")

  @@index([id_usuario], map: "idx_metas_usuario")
}

model transacoes {
  id_transacao   Int                @id @default(autoincrement())
  id_usuario     Int
  id_categoria   Int
  valor          Decimal            @db.Decimal(10, 2)
  tipo           transacoes_tipo
  descricao      String             @db.VarChar(200)
  data_transacao DateTime           @db.Date
  status         transacoes_status? @default(confirmada)
  created_at     DateTime?          @default(now()) @db.Timestamp(0)
  updated_at     DateTime?          @default(now()) @updatedAt @db.Timestamp(0)
  categorias     categorias         @relation(fields: [id_categoria], references: [id_categoria], map: "fk_categoria")
  usuarios       usuarios           @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, map: "transacoes_ibfk_2")

  @@index([id_categoria], map: "idx_transacoes_categoria")
  @@index([data_transacao], map: "idx_transacoes_data")
  @@index([id_usuario], map: "idx_transacoes_usuario")
}

model usuarios {
  id_usuario        Int                 @id @default(autoincrement())
  nome              String              @db.VarChar(50)
  sobrenome         String?             @db.VarChar(50)
  email             String              @unique(map: "email") @db.VarChar(150)
  senha             String?             @db.VarChar(255)
  google_id         String?             @unique(map: "google_id") @db.VarChar(255)
  foto_perfil       String?             @db.VarChar(255)
  email_verificado  Boolean?            @default(false)
  ultimo_login      DateTime?           @db.DateTime(0)
  created_at        DateTime?           @default(now()) @db.Timestamp(0)
  updated_at        DateTime?           @default(now()) @updatedAt @db.Timestamp(0)
  categorias        categorias[]
  metas_financeiras metas_financeiras[]
  transacoes        transacoes[]
}

enum categorias_tipo {
  receita
  despesa
}

enum transacoes_tipo {
  receita
  despesa
}

enum metas_financeiras_status {
  em_andamento
  concluida
  cancelada
}

enum transacoes_status {
  confirmada
  pendente
}
