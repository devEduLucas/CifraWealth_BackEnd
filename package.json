{
  "name": "CifraWealth",
  "version": "1.0.0",
  "description": "API do CifraWealth — Node.js, Express, TypeScript, Prisma e MySQL.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "test": "node --import tsx --test test/reports.test.ts test/authTokens.test.ts test/authMiddleware.test.ts test/profile.test.ts",
    "test:integration": "node --import tsx --test test/sprint5.integration.ts test/auth.integration.ts test/profile.integration.ts",
    "db:seed": "prisma db seed",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "@prisma/config": { "deepmerge-ts": "8.0.2" },
    "gaxios": { "uuid": "11.1.1" }
  },
  "license": "ISC"
}
